  create  table "dm_centro_psicologico"."datamart"."fact_facturacion__dbt_tmp"
  
  
    as
  
  (
    with pagos as (
    select * from "dm_centro_psicologico"."staging"."stg_pagos"
),
sesiones as (
    select sesion_id, historia_id, psicologo_id from "dm_centro_psicologico"."staging"."stg_sesiones"
),
historias as (
    select historia_id, paciente_id from "dm_centro_psicologico"."staging"."stg_historia_clinica"
),
psicologos as (
